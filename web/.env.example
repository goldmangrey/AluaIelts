# Existing FastAPI upstream, including API prefix.
# Browser requests use the built-in same-origin Next rewrite /api/alua/*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Firebase WEB app configuration from the existing Alua Firebase project.
# Public identifiers only. Never add an Admin SDK key or service account.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
