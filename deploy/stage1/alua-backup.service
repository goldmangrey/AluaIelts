[Unit]
Description=Alua encrypted local PostgreSQL backup (external destination pending)
After=postgresql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/libexec/alua-backup
TimeoutStartSec=20min
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
TasksMax=32
LimitFSIZE=268435456
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/alua /var/lib/alua-backup
LogNamespace=alua
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
