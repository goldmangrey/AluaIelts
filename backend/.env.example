APP_NAME=Alua API
APP_VERSION=0.1.0
APP_ENV=local
DEBUG=true
API_PREFIX=/api/v1

OPENAI_API_KEY=
OPENAI_EXERCISE_MODEL=gpt-5.6-luna
OPENAI_EXERCISE_GENERATION_ENABLED=true
OPENAI_EXERCISE_TIMEOUT_SECONDS=20
OPENAI_EXERCISE_MAX_RETRIES=1
OPENAI_EXERCISE_MAX_OUTPUT_TOKENS=2500
OPENAI_ANALYSIS_MODEL=gpt-5.6-terra
OPENAI_PROGRESS_ANALYSIS_ENABLED=true
OPENAI_PROGRESS_TIMEOUT_SECONDS=30
OPENAI_PROGRESS_MAX_RETRIES=1
OPENAI_PROGRESS_MAX_OUTPUT_TOKENS=3000
OPENAI_PROGRESS_CHAT_HISTORY_LIMIT=8

DATABASE_URL=postgresql+psycopg://alua:change-me@127.0.0.1:5432/alua
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
ENROLLMENT_CODE_TTL_MINUTES=30

ALLOWED_ORIGINS=
